{
  "name": "sanketone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/test-security-rules.mjs\"",
    "test:auth": "firebase emulators:exec --only auth,firestore \"node scripts/test-auth-flows.mjs\"",
    "test:complaints": "firebase emulators:exec --only firestore,auth,storage \"node scripts/test-step4-lifecycle.mjs\"",
    "test:workflows": "firebase emulators:exec --only firestore,auth \"node scripts/test-step5-6-workflows.mjs\"",
    "provision:admin": "node scripts/provision-admin.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "firebase-functions": "^7.4.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
