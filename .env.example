# ==============================================================================
# SANKETONE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Feature Flags
# Enable isolated frontend demo mode with local state persistence
VITE_DEMO_MODE=true

# Institutional Configuration
# Whitelisted email domain patterns for student onboarding (comma-separated or regex pattern)
# Configurable: will be set by the campus before production authentication.
VITE_ALLOWED_STUDENT_EMAIL_DOMAINS=*

# Evidence Upload Quotas
VITE_MAX_EVIDENCE_FILES=3
VITE_MAX_IMAGE_SIZE_MB=2

# Firebase Client Configuration (Public API Credentials - No Secret Keys)
VITE_FIREBASE_API_KEY=AIzaSyFakeKeyForLocalDevelopment12345
VITE_FIREBASE_AUTH_DOMAIN=sanketone-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sanketone-dev
VITE_FIREBASE_STORAGE_BUCKET=sanketone-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase Local Emulator Suite Settings
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001
